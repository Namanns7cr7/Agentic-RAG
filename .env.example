# ── LLM Provider Configuration ────────────────────────────────────
# Options: ollama | openai_compatible | local
LLM_PROVIDER=ollama

# Default model — change based on your hardware
# Options: qwen3.5:4b, qwen3.5:9b, qwen3.5:27b, qwen3.5:35b
LLM_MODEL=qwen3.5:9b

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible settings (vLLM, LM-Studio, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=dummy

# Fallback model when Ollama/OpenAI-compatible is unreachable
FALLBACK_MODEL=google/flan-t5-base
