# ── LLM Provider Configuration ────────────────────────────────────
# Options: ollama | openai_compatible | local
LLM_PROVIDER=ollama

# Default model — change based on your hardware
# Options: qwen3.5:4b, qwen3.5:9b, qwen3.5:27b, qwen3.5:35b
LLM_MODEL=qwen3.5:9b

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible settings (vLLM, LM-Studio, etc.)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=dummy

# Fallback model when Ollama/OpenAI-compatible is unreachable
FALLBACK_MODEL=google/flan-t5-base

# ── Vertex AI (optional production-grade provider) ─────────────────
# Activate with: gcloud auth application-default login
# Then set RAG_PROVIDER=vertex to use Gemini on Google Cloud.
#
# IMPORTANT: Never commit real project IDs or credentials to source control.
# Use this file as a template only — copy to .env and fill in locally.

# Set to "vertex" to use Vertex AI for both LLM and (optionally) embeddings
RAG_PROVIDER=

# GCP project and region
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI Gemini model (gemini-2.5-flash recommended; gemini-2.0-flash is another option)
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# ── Embedding Provider ─────────────────────────────────────────────
# Options: local | vertex
# "local"  → sentence-transformers/all-MiniLM-L6-v2 (CPU, no cloud cost)
# "vertex" → text-embedding-004 on Google Vertex AI (higher quality, small cost)
# If EMBEDDING_PROVIDER is not set, it inherits from RAG_PROVIDER.
EMBEDDING_PROVIDER=local

# Vertex embedding model (only used when EMBEDDING_PROVIDER=vertex)
VERTEX_EMBEDDING_MODEL=text-embedding-004
